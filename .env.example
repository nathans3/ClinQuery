# Required. Used for chat, OCR, and embeddings.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna.
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Optional. Fast vision OCR model. Defaults to gpt-4o-mini.
OPENAI_OCR_MODEL=gpt-4o-mini

# Optional. Defaults to text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Vercel Blob token for production file + index storage.
# Leave empty for local development (files go in .data/).
BLOB_READ_WRITE_TOKEN=

# Optional. If set, the UI requires this password before anyone can use your key.
APP_PASSWORD=
